# GreenBuild Platform Backend Environment Variables Configuration

NODE_ENV=development
PORT=5000

# Database Configuration (MongoDB Atlas Connection URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/greenbuild?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Frontend Application URL (for OAuth callback redirect)
FRONTEND_URL=http://localhost:5173

# CORS Origin Allowed Origins (comma separated, or * for all in dev)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Google OAuth 2.0 / OpenID Connect Credentials (Backend-Only)
# Obtain these from Google Cloud Console (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
